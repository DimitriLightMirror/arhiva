# --- OCR ---
TESSERACT_LANG=ron
TESSERACT_FALLBACK_LANG=ron+eng
OCR_DPI=300
OCR_LOW_CONF_THRESHOLD=60

# --- LLM provider: ollama | openai | none ---
LLM_PROVIDER=ollama

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI-compatible API (any provider exposing /chat/completions)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=120
LLM_MAX_BLOCK_CHARS=3500

# --- Storage / ingest ---
ARCHIVE_ROOT=./archive
WATCH_FOLDER=./watch
DATA_DIR=./data

# --- Server ---
HOST=0.0.0.0
PORT=8000
